

# Backend API URL (required)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# WalletConnect Project ID (required for wallet connection)
# Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# Pinata IPFS gateway for media (optional, has default)
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# PolyX contract address (optional, for Tip button on posts)
# Must match backend POLYX_CONTRACT_ADDRESS after deploying with tip() function
NEXT_PUBLIC_POLYX_CONTRACT_ADDRESS=0x...
